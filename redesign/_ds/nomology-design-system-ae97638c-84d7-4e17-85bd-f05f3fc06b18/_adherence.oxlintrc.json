{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/display/**",
              "components/feedback/**",
              "components/forms/**",
              "components/surfaces/**",
              "ui_kits/nomology_app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Judson|Nunito Sans|Material Symbols Rounded))/i]",
        "message": "Font not provided by the design system. Available: Judson, Nunito Sans, Material Symbols Rounded."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|size|index|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, src, size, index, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|label|color|solid|dark|icon|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, label, color, solid, dark, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:brand|blue|teal|success|warning|error|neutral)$/]",
        "message": "<Badge> color must be one of 'brand' | 'blue' | 'teal' | 'success' | 'warning' | 'error' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|title|subtitle|children|dark|maxWidth|style|key|ref|className|style|children)$/]",
        "message": "<BottomSheet> doesn't accept that prop. Declared props: open, onClose, title, subtitle, children, dark, maxWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|onClick|variant|size|fullWidth|leadingIcon|trailingIcon|isAi|dark|disabled|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: label, children, onClick, variant, size, fullWidth, leadingIcon, trailingIcon, isAi, dark, disabled, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|fill|padding|radius|outlined|shadow|dark|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, fill, padding, radius, outlined, shadow, dark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|subtitle|action|isError|dark|compact|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, title, subtitle, action, isError, dark, compact, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlavorChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|color|index|style|key|ref|className|style|children)$/]",
        "message": "<FlavorChip> doesn't accept that prop. Declared props: label, color, index, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlavorRadarChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:flavorValues|size|gridColor|gridRings|pointColors|style|key|ref|className|style|children)$/]",
        "message": "<FlavorRadarChart> doesn't accept that prop. Declared props: flavorValues, size, gridColor, gridRings, pointColors, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlavorDescriptor'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|intensity|key|ref|className|style|children)$/]",
        "message": "<FlavorDescriptor> doesn't accept that prop. Declared props: name, intensity."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|onClick|variant|size|dark|round|disabled|ariaLabel|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, onClick, variant, size, dark, round, disabled, ariaLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|soft|outline|ghost)$/]",
        "message": "<IconButton> variant must be one of 'solid' | 'soft' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:small|medium|large)$/]",
        "message": "<IconButton> size must be one of 'small' | 'medium' | 'large'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|placeholder|required|multiline|rows|dark|leadingIcon|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, value, onChange, placeholder, required, multiline, rows, dark, leadingIcon, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MatchBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:score|size|circle|processing|style|key|ref|className|style|children)$/]",
        "message": "<MatchBadge> doesn't accept that prop. Declared props: score, size, circle, processing, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RecipeCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|image|time|difficulty|match|flavors|bookmarked|onBookmark|onClick|style|key|ref|className|style|children)$/]",
        "message": "<RecipeCard> doesn't accept that prop. Declared props: name, image, time, difficulty, match, flavors, bookmarked, onBookmark, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|descriptor|count|action|dark|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: title, descriptor, count, action, dark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|disabled|key|ref|className|style|children)$/]",
        "message": "<SegmentOption> doesn't accept that prop. Declared props: label, icon, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|label|icon|selected|onClick|dark|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, label, icon, selected, onClick, dark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|secondary|action|onAction|icon|style|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: message, secondary, action, onAction, icon, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
